year = {2022}, 
title = {{Integrative metabolomics‐genomics approach reveals key metabolic pathways and regulators of Alzheimer's disease}}, 
author = {Horgusluoglu, Emrin and Neff, Ryan and Song, Won‐Min and Wang, Minghui and Wang, Qian and Arnold, Matthias and Krumsiek, Jan and Galindo‐Prieto, Beatriz and Ming, Chen and Nho, Kwangsik and Kastenmüller, Gabi and Han, Xianlin and Baillie, Rebecca and Zeng, Qi and Andrews, Shea and Cheng, Haoxiang and Hao, Ke and Goate, Alison and Bennett, David A. and Saykin, Andrew J. and Kaddurah‐Daouk, Rima and Zhang, Bin and (ADNI), for the Alzheimer's Disease Neuroimaging Initiative and Consortium, the Alzheimer Disease Metabolomics}, 
journal = {Alzheimer's \& Dementia}, 
issn = {1552-5260}, 
